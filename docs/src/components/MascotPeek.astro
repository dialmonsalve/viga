---
import peek from '../assets/mascot-peek.svg';
import eyes from '../assets/mascot-peek-eyes.svg?raw';
---

<mascot-peek class="figure" aria-hidden="true">
  <img src={peek.src} alt="" width="64" height="52" decoding="async" />
  <Fragment set:html={eyes} />
</mascot-peek>

<script>
  const MAX_X = 22;
  const MAX_UP = 26;
  const MAX_DOWN = 6;
  const REACH = 240;

  class MascotPeek extends HTMLElement {
    private frame = 0;
    private pointerX = 0;
    private pointerY = 0;

    private readonly update = () => {
      this.frame = 0;
      const box = this.getBoundingClientRect();
      if (box.width === 0) return;

      const dx = this.pointerX - (box.left + box.width / 2);
      const dy = this.pointerY - (box.top + box.height * 0.45);
      const distance = Math.hypot(dx, dy) || 1;
      const strength = Math.min(1, distance / REACH);
      const x = (dx / distance) * MAX_X * strength;
      const y = (dy / distance) * (dy < 0 ? MAX_UP : MAX_DOWN) * strength;

      this.querySelectorAll<SVGGElement>('.pupil').forEach((pupil) => {
        pupil.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px)`;
      });
    };

    private readonly follow = (event: PointerEvent) => {
      this.pointerX = event.clientX;
      this.pointerY = event.clientY;
      if (!this.frame) this.frame = requestAnimationFrame(this.update);
    };

    connectedCallback() {
      const follows =
        matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (follows) addEventListener('pointermove', this.follow, { passive: true });
    }

    disconnectedCallback() {
      removeEventListener('pointermove', this.follow);
      cancelAnimationFrame(this.frame);
      this.frame = 0;
    }
  }

  if (!customElements.get('mascot-peek')) customElements.define('mascot-peek', MascotPeek);
</script>

<style>
  .figure {
    position: relative;
    display: block;
    width: 4rem;
  }

  .figure img {
    display: block;
    width: 100%;
    height: auto;
  }

  .figure :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .figure :global(.eye) {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: peek-blink 7s ease-in-out infinite;
  }

  .figure :global(.pupil) {
    transition: transform 120ms ease-out;
  }

  @keyframes peek-blink {
    0%,
    92%,
    100% {
      transform: scaleY(1);
    }

    95% {
      transform: scaleY(0.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .figure :global(.eye) {
      animation: none;
    }

    .figure :global(.pupil) {
      transition: none;
    }
  }
</style>
