---
import { Icon } from '@astrojs/starlight/components';
import { LANGS, LANG_NAMES, LANG_TAGS, type Lang } from '../../i18n';

const current = (Astro.locals.starlightRoute.locale ?? 'es') as Lang;
const hrefFor = (target: Lang) =>
  Astro.url.pathname.replace(new RegExp(`^/${current}(?=/|$)`), `/${target}`);
---

<viga-lang-menu>
  <details>
    <summary aria-label={Astro.locals.t('languageSelect.accessibleLabel')}>
      <Icon name="translate" size="1rem" />
      <span class="code">{current.toUpperCase()}</span>
      <Icon name="down-caret" size="0.875rem" class="caret" />
    </summary>
    <ul>
      {
        LANGS.map((lang) => (
          <li>
            <a
              href={hrefFor(lang)}
              hreflang={LANG_TAGS[lang]}
              lang={LANG_TAGS[lang]}
              aria-current={lang === current ? 'true' : undefined}
            >
              {LANG_NAMES[lang]}
              {lang === current && <Icon name="approve-check" size="1rem" />}
            </a>
          </li>
        ))
      }
    </ul>
  </details>
</viga-lang-menu>

<script>
  class VigaLangMenu extends HTMLElement {
    connectedCallback() {
      const details = this.querySelector('details');
      const summary = this.querySelector('summary');
      if (!details || !summary) return;

      document.addEventListener('click', (event) => {
        if (details.open && !this.contains(event.target as Node)) details.open = false;
      });

      this.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && details.open) {
          details.open = false;
          summary.focus();
        }
      });
    }
  }

  customElements.define('viga-lang-menu', VigaLangMenu);
</script>

<style>
  details {
    position: relative;
  }

  summary {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    height: 2.25rem;
    padding: 0 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    list-style: none;
    cursor: pointer;
    transition:
      border-color 150ms ease,
      color 150ms ease;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover,
  details[open] summary {
    border-color: var(--sl-color-gray-4);
    color: var(--sl-color-white);
  }

  summary:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  .caret {
    transition: transform 150ms ease;
  }

  details[open] .caret {
    transform: rotate(180deg);
  }

  ul {
    position: absolute;
    top: calc(100% + 0.375rem);
    right: 0;
    z-index: 10;
    min-width: 10rem;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.625rem;
    box-shadow: var(--sl-shadow-md);
  }

  a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.625rem;
    border-radius: 0.375rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }

  a:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  a:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: -2px;
  }

  a[aria-current='true'] {
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    summary,
    .caret {
      transition: none;
    }
  }
</style>
