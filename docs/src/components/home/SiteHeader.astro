---
import logo from '../../assets/logo-light.svg?raw';
import MascotPeek from '../MascotPeek.astro';
import { LANGS, LANG_NAMES, LANG_TAGS, getDictionary, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
  github: string;
}

const { lang, github } = Astro.props;
const t = getDictionary(lang).home;
const docs = (path: string) => `/${lang}/${path}`;
const mark = logo
  .replace('<svg ', '<svg aria-hidden="true" focusable="false" ')
  .replaceAll('fill="#172443"', 'fill="currentColor"');
---

<header class="bar">
  <a class="brand" href={`/${lang}/`}>
    <Fragment set:html={mark} />
    {t.brand}
  </a>

  <nav class="links" aria-label={t.nav.label}>
    <a href={docs('start/what-is-viga/')} aria-label={t.nav.docs}>
      <span class="long">{t.nav.docs}</span>
      <span class="short" aria-hidden="true">{t.nav.docsShort}</span>
    </a>
    <a class="wide" href="#modules">{t.nav.modules}</a>
    <a class="wide" href="#guides">{t.nav.guides}</a>
  </nav>

  <div class="peek">
    <MascotPeek />
  </div>

  <a class="cta wide" href={docs('start/installation/')}>{t.cta}</a>

  <nav aria-label={t.languages}>
    <ul class="languages">
      {
        LANGS.map((target) => (
          <li>
            <a
              href={`/${target}/`}
              hreflang={LANG_TAGS[target]}
              lang={LANG_TAGS[target]}
              aria-label={LANG_NAMES[target]}
              aria-current={target === lang ? 'page' : undefined}
            >
              {target.toUpperCase()}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="icons">
    <a class="icon github" href={github} aria-label="GitHub">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
        <path
          d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
        ></path>
      </svg>
    </a>
    <theme-toggle data-to-dark={t.theme.toDark} data-to-light={t.theme.toLight}>
      <button class="icon" type="button" aria-label={t.theme.toDark}>
        <svg
          class="moon"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
        <svg
          class="sun"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
    </theme-toggle>
  </div>
</header>

<script>
  const STORAGE_KEY = 'starlight-theme';

  class ThemeToggle extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button');
      if (!button) return;

      const isDark = () => {
        const { theme } = document.documentElement.dataset;
        return theme ? theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      };

      const label = () => {
        const { toDark = '', toLight = '' } = this.dataset;
        button.setAttribute('aria-label', isDark() ? toLight : toDark);
      };

      label();

      button.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem(STORAGE_KEY, next);
        } catch {
          return;
        } finally {
          label();
        }
      });
    }
  }

  if (!customElements.get('theme-toggle')) customElements.define('theme-toggle', ThemeToggle);
</script>

<style>
  .bar {
    position: sticky;
    top: 0.75rem;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    max-width: 74rem;
    margin: 0.75rem;
    padding: 0.5rem 0.75rem 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(12px);
  }

  @media (min-width: 76rem) {
    .bar {
      margin-inline: auto;
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline-end: 0.5rem;
    color: var(--color-accent-strong);
    font-size: 1.125rem;
    font-weight: 700;
    text-decoration: none;
  }

  .brand :global(svg) {
    display: block;
    width: 1.375rem;
    height: auto;
  }

  .links {
    display: flex;
    gap: 1rem;
    margin-inline-end: auto;
  }

  .links a {
    padding-block: 0.25rem;
    color: var(--color-muted);
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .links a:hover {
    color: var(--color-accent);
  }

  .peek {
    display: none;
  }

  @media (min-width: 60rem) {
    .peek {
      position: absolute;
      bottom: 0;
      left: 50%;
      display: block;
      width: 3.25rem;
      transform: translateX(-50%);
    }

    .peek :global(mascot-peek) {
      width: 100%;
    }
  }

  .cta {
    padding: 0.5rem 0.875rem;
    border-radius: 0.625rem;
    background: var(--color-accent);
    color: var(--color-accent-text);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 150ms ease;
  }

  .cta:hover {
    opacity: 0.85;
  }

  .wide,
  .short {
    display: none;
  }

  @media (max-width: 30rem) {
    .bar {
      flex-wrap: nowrap;
      gap: 0.5rem;
    }

    .brand {
      margin-inline-end: 0;
    }

    .long {
      display: none;
    }

    .short {
      display: inline;
    }
  }

  @media (max-width: 23rem) {
    .bar {
      gap: 0.25rem;
      padding-inline: 0.625rem 0.25rem;
    }

    .github {
      display: none;
    }
  }

  @media (min-width: 52rem) {
    .wide {
      display: inline-block;
    }
  }

  .languages {
    display: flex;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .languages a {
    display: inline-block;
    padding: 0.25rem 0.375rem;
    border-radius: 0.375rem;
    color: var(--color-muted);
    font-size: 0.8125rem;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .languages a:hover {
    color: var(--color-text);
  }

  .languages a[aria-current='page'] {
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-weight: 700;
  }

  .icons {
    display: flex;
    gap: 0.125rem;
  }

  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 0.5rem;
    background: none;
    color: var(--color-muted);
    cursor: pointer;
    transition: color 150ms ease, background-color 150ms ease;
  }

  .icon:hover {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .sun {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: block;
    }

    :global(:root:not([data-theme='light'])) .moon {
      display: none;
    }
  }

  :global(:root[data-theme='dark']) .sun {
    display: block;
  }

  :global(:root[data-theme='dark']) .moon {
    display: none;
  }
</style>
