---
import { ClientRouter } from 'astro:transitions';
import { LANGS, LANG_TAGS, type Lang } from '../i18n';
import SocialImage from '../components/SocialImage.astro';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pathFor = (target: Lang) => Astro.url.pathname.replace(new RegExp(`^/${lang}(?=/|$)`), `/${target}`);
---

<!doctype html>
<html lang={LANG_TAGS[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      LANGS.map((target) => (
        <link rel="alternate" hreflang={LANG_TAGS[target]} href={new URL(pathFor(target), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor('es'), Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={LANG_TAGS[lang]} />
    <meta property="og:site_name" content="viga" />
    <meta name="twitter:card" content="summary_large_image" />
    <SocialImage lang={lang} />
    <ClientRouter />
    <script is:inline>
      (() => {
        const apply = () => {
          try {
            const theme = localStorage.getItem('starlight-theme');
            if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
          } catch {}
        };

        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-bg: light-dark(#ffffff, #12151f);
    --color-text: light-dark(#17181c, #eceef2);
    --color-muted: light-dark(#545864, #a9aebb);
    --color-border: light-dark(#d8dde8, #2c3244);
    --color-surface: light-dark(#f4f6fb, #1a1f2d);
    --color-accent: light-dark(#2b4478, #9db3ee);
    --color-accent-strong: light-dark(#172443, #dbe3fa);
    --color-accent-text: light-dark(#ffffff, #10131f);
    --color-accent-soft: light-dark(#e9eef9, #1c2438);
    --color-glow: light-dark(#7f9fe6, #3f62bd);
    --color-spot: light-dark(#2f62d9, #b4c8ff);
    --color-success: light-dark(#1a6b3c, #7fd6a2);
    --color-danger: light-dark(#b3261e, #f2a39d);
    --astro-code-foreground: var(--color-text);
    --astro-code-background: var(--color-surface);
    --astro-code-token-keyword: light-dark(#8a2f7d, #e0a6ea);
    --astro-code-token-string: light-dark(#1a6b3c, #7fd6a2);
    --astro-code-token-string-expression: light-dark(#1a6b3c, #7fd6a2);
    --astro-code-token-function: light-dark(#2b4478, #9db3ee);
    --astro-code-token-constant: light-dark(#8a4b08, #f0c27b);
    --astro-code-token-parameter: var(--color-text);
    --astro-code-token-punctuation: var(--color-muted);
    --astro-code-token-comment: var(--color-muted);
    --astro-code-token-link: var(--color-accent);
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    color-scheme: light dark;
  }

  :root[data-theme='light'] {
    color-scheme: light;
  }

  :root[data-theme='dark'] {
    color-scheme: dark;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.5;
  }

  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
</style>
